# Copie este arquivo para .env e ajuste os valores locais.
# Nunca commite o arquivo .env nem senhas reais.

# PostgreSQL
POSTGRES_USER=voto
POSTGRES_PASSWORD=altere_esta_senha
POSTGRES_DB=voto_transparente
# Use 5433 se a porta 5432 já estiver ocupada no seu computador.
POSTGRES_PORT=5432
POSTGRES_HOST=db

# URL usada pelo backend dentro da rede Docker
DATABASE_URL=postgresql+psycopg2://voto:altere_esta_senha@db:5432/voto_transparente

# Flask
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=altere_esta_chave_secreta
# Use 5001 se a porta 5000 já estiver ocupada (comum no Windows).
BACKEND_PORT=5000

# Origem permitida no CORS (URL do frontend no navegador)
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000
