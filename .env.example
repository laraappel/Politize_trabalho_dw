# Copie este arquivo para .env e ajuste os valores locais.
# Nunca commite o arquivo .env nem senhas reais.

# PostgreSQL
POSTGRES_USER=pgAdmin 4
POSTGRES_PASSWORD=Morango
POSTGRES_DB=politize
# Use 5433 se a porta 5432 já estiver ocupada no seu computador.
POSTGRES_PORT=5432
POSTGRES_HOST=db

# URL usada pelo backend dentro da rede Docker
DATABASE_URL=postgresql+psycopg2://pgAdmin 4:Morango@db:5432/politize

# Flask
FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=AQ.Ab8RN6Jn8xAjSuPt6twko2gpv91m5UKlmvlc61mv5I7Cah2iRw
# Use 5001 se a porta 5000 já estiver ocupada (comum no Windows).
BACKEND_PORT=5000

# Origem permitida no CORS (URL do frontend no navegador)
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000

# Módulo de notícias (ver docs/NOTICIAS.md)
# Token das operações editoriais (revisão, atualizações). Vazio = operações desabilitadas.
ADMIN_TOKEN=
NOTICIAS_USER_AGENT=VotoTransparenteBot/0.1 (projeto academico; leitura de RSS publico)
NOTICIAS_HTTP_TIMEOUT=15
NOTICIAS_INTERVALO_MIN_SEGUNDOS=900
NOTICIAS_RESUMO_MAX_CHARS=300
AGENCIA_BRASIL_EDITORIAS=politica,justica
IMPORTAR_DADOS_DEMO=1

# Câmara dos Deputados (dados abertos, sem token). Ver docs/CAMARA.md
CAMARA_USER_AGENT=VotoTransparente/0.1 (projeto academico; dados abertos da Camara)
CAMARA_HTTP_TIMEOUT=20
CAMARA_INTERVALO_SEGUNDOS=0.4
CAMARA_TENTATIVAS=3
CAMARA_ITENS_POR_PAGINA=100
